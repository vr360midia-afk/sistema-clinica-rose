# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA CLÍNICA
# ==============================================================================

# Supabase (Frontend & Backend)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_chave_publica_aqui"
VITE_SUPABASE_ANON_KEY="sua_chave_anonima_aqui"

# ==============================================================================
# INTEGRAÇÃO WHATSAPP CLOUD API (META) - COEXISTÊNCIA COM WHATSAPP BUSINESS
# Configure estas variáveis de ambiente nas Edge Functions do Supabase:
# (Painel Supabase -> Project Settings -> Edge Functions -> Secrets)
# ==============================================================================

# 1. Token de Verificação do Webhook (qualquer texto seguro criado por você, ex: clinica_secret_token_2026)
WA_VERIFY_TOKEN="seu_token_de_verificacao_do_webhook"

# 2. Segredo do Aplicativo da Meta (App Secret obtido em: Meta for Developers -> Configurações -> Básico)
# Usado para validar a assinatura de segurança HMAC SHA-256 (x-hub-signature-256)
WA_APP_SECRET="seu_app_secret_da_meta"

# 3. Token de Acesso da Meta (Token Permanente de Usuário do Sistema com permissão whatsapp_business_messaging)
WA_TOKEN="seu_token_permanente_da_meta_cloud_api"

# 4. ID do Número de Telefone (Identificador de 15 dígitos gerado no Painel do WhatsApp da Meta)
WA_PHONE_NUMBER_ID="seu_phone_number_id_aqui"
